# Required for a live Analyst/Writer run (not needed with EXAMPLE_BRIEFING=1)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: load the illustrative example briefing at startup (no API key)
# EXAMPLE_BRIEFING=1

# Optional: Access token to protect the /run endpoint
# If set, requests must include ?key=<token> or X-Access-Token header
BRIEFING_TOKEN=

# Optional: Port for the Flask server (default: 8080)
PORT=8080
